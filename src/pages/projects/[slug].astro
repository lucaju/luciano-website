---
import { StripedPattern } from '@/components/pattern/striped-pattern';
import Seo from '@/components/seo.astro';
import RootLayout from '@/layouts/root-layout.astro';
import { projectMetaDescription } from '@/modules/projects/project-model';
import { ProjectPage } from '@/modules/projects/project-page';
import { showcaseProjects } from '@/modules/projects/showcase-projects';

export function getStaticPaths() {
	return showcaseProjects.map((project) => ({
		params: { slug: project.slug },
		props: {
			description: projectMetaDescription(project),
			slug: project.slug,
			title: project.title,
		},
	}));
}

const { description, slug, title } = Astro.props;
---

<RootLayout scrollSmooth>
	<Seo slot="metadata" {description} {title} />

	<div class="relative">
		<header class="container-fluid pt-32 md:pt-22 lg:pt-24 pb-6">
			<a class="text-sm font-medium text-muted-foreground hover:underline" href="/projects">All projects</a>
			<StripedPattern
				className="fixed h-[300px] w-full top-0 mask-[radial-gradient(300px_circle_at_top,white,transparent)] stroke-[0.3] [stroke-dasharray:8,4]"
			/>
		</header>
	</div>
	<section class="container-fluid">
		<ProjectPage client:load slug={slug} />
	</section>
</RootLayout>
